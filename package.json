{
  "name": "seismic-waveform-analyzer-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm run install:frontend && npm run install:backend",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && pip install -r requirements.txt",
    "dev": "npm-run-all -p dev:backend wait:backend dev:frontend",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --port 8001",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:separate": "npm-run-all -p dev:backend dev:frontend",
    "start": "npm run dev",
    "start:backend": "npm run dev:backend",
    "start:frontend": "npm run dev:frontend",
    "wait:backend": "node scripts/wait-for-backend.js",
    "health": "node scripts/health-check.js",
    "check": "npm run health",
    "lint:frontend": "cd frontend && vue-tsc --noEmit",
    "build:frontend": "cd frontend && npm run build"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
